# MySQL
export MYSQL_DSN="root:123456@tcp(127.0.0.1:3306)/timespace?charset=utf8mb4&parseTime=True&loc=Local"

# Redis
export REDIS_ADDR="127.0.0.1:6379"
export REDIS_DB="0"
export REDIS_PASSWORD=""

# 微信小程序
export WECHAT_APP_ID="your_app_id"
export WECHAT_APP_SECRET="your_app_secret"

# JWT
export JWT_SECRET="timespace-jwt-secret-key-change-in-production"

# ============ 文件存储 ============
# UPLOAD_DRIVER: local（本地磁盘） | cos（腾讯云对象存储）
export UPLOAD_DRIVER="local"

# 腾讯云 COS（仅 UPLOAD_DRIVER=cos 时需要填写）
export COS_SECRET_ID=""
export COS_SECRET_KEY=""
# 桶访问域名，例如 https://timespace-1300000000.cos.ap-guangzhou.myqcloud.com
export COS_BUCKET_URL=""
# CDN 加速域名（可选），例如 https://cdn.yourdomain.com
export COS_CDN_DOMAIN=""
